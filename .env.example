# Only set keys for the vendors you actually want to test.
# `polycall doctor` reports which of these resolve.
# NEVER commit the real .env — it is in .gitignore.

RETELL_API_KEY=
VAPI_API_KEY=
ELEVENLABS_API_KEY=
BLAND_API_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
TELNYX_API_KEY=

# Referee ASR — optional. Leave blank to self-host faster-whisper.
GEMINI_API_KEY=
SARVAM_API_KEY=
GROQ_API_KEY=

# Hard spend ceiling, enforced client-side. Recommended.
POLYCALL_MAX_SPEND=25
